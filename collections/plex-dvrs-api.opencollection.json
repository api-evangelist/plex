{
  "opencollection": "1.0.0",
  "info": {
    "name": "Plex Media Server DV Rs API",
    "version": "1.2.2\n"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Plex-Token",
      "value": "{{X-Plex-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "DVRs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get DVRs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs"
          },
          "docs": "Get the list of all available DVRs"
        },
        {
          "info": {
            "name": "Create a DVR",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs",
            "params": [
              {
                "name": "lineup",
                "value": "lineup://tv.plex.providers.epg.onconnect/USA-HI51418-DEFAULT",
                "type": "query",
                "description": "The EPG lineup."
              },
              {
                "name": "device",
                "value": "device[]=device://tv.plex.grabbers.hdhomerun/1053C0CA",
                "type": "query",
                "description": "The device."
              },
              {
                "name": "language",
                "value": "eng",
                "type": "query",
                "description": "The language."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Creation of a DVR, after creation of a devcie and a lineup is selected"
        },
        {
          "info": {
            "name": "Get a single DVR",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs/:dvrId",
            "params": [
              {
                "name": "dvrId",
                "value": "",
                "type": "path",
                "description": "The ID of the DVR."
              }
            ]
          },
          "docs": "Get a single DVR by its id (key)"
        },
        {
          "info": {
            "name": "Delete a single DVR",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs/:dvrId",
            "params": [
              {
                "name": "dvrId",
                "value": "",
                "type": "path",
                "description": "The ID of the DVR."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Delete a single DVR by its id (key)"
        },
        {
          "info": {
            "name": "Tune a channel on a DVR",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs/:dvrId/channels/:channel/tune",
            "params": [
              {
                "name": "dvrId",
                "value": "",
                "type": "path",
                "description": "The ID of the DVR."
              },
              {
                "name": "channel",
                "value": "2.1",
                "type": "path",
                "description": "The channel ID to tune"
              }
            ]
          },
          "docs": "Tune a channel on a DVR to the provided channel"
        },
        {
          "info": {
            "name": "Add a device to an existing DVR",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs/:dvrId/devices/:deviceId",
            "params": [
              {
                "name": "dvrId",
                "value": "",
                "type": "path",
                "description": "The ID of the DVR."
              },
              {
                "name": "deviceId",
                "value": "",
                "type": "path",
                "description": "The ID of the device to add."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Add a device to an existing DVR"
        },
        {
          "info": {
            "name": "Remove a device from an existing DVR",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs/:dvrId/devices/:deviceId",
            "params": [
              {
                "name": "dvrId",
                "value": "",
                "type": "path",
                "description": "The ID of the DVR."
              },
              {
                "name": "deviceId",
                "value": "",
                "type": "path",
                "description": "The ID of the device to add."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Remove a device from an existing DVR"
        },
        {
          "info": {
            "name": "Add a DVR Lineup",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs/:dvrId/lineups",
            "params": [
              {
                "name": "dvrId",
                "value": "",
                "type": "path",
                "description": "The ID of the DVR."
              },
              {
                "name": "lineup",
                "value": "",
                "type": "query",
                "description": "The lineup to delete"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Add a lineup to a DVR device's set of lineups."
        },
        {
          "info": {
            "name": "Delete a DVR Lineup",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs/:dvrId/lineups",
            "params": [
              {
                "name": "dvrId",
                "value": "",
                "type": "path",
                "description": "The ID of the DVR."
              },
              {
                "name": "lineup",
                "value": "",
                "type": "query",
                "description": "The lineup to delete"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Deletes a DVR device's lineup."
        },
        {
          "info": {
            "name": "Set DVR preferences",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs/:dvrId/prefs",
            "params": [
              {
                "name": "dvrId",
                "value": "",
                "type": "path",
                "description": "The ID of the DVR."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Set the `name` preference to the provided value"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Set DVR preferences by name avd value"
        },
        {
          "info": {
            "name": "Tell a DVR to reload program guide",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs/:dvrId/reloadGuide",
            "params": [
              {
                "name": "dvrId",
                "value": "",
                "type": "path",
                "description": "The ID of the DVR."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Tell a DVR to reload program guide"
        },
        {
          "info": {
            "name": "Tell a DVR to stop reloading program guide",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/livetv/dvrs/:dvrId/reloadGuide",
            "params": [
              {
                "name": "dvrId",
                "value": "",
                "type": "path",
                "description": "The ID of the DVR."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Tell a DVR to stop reloading program guide"
        }
      ]
    }
  ],
  "bundled": true
}