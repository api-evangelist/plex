{
  "opencollection": "1.0.0",
  "info": {
    "name": "Plex Media Server Library Collections API",
    "version": "1.2.2\n"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Plex-Token",
      "value": "{{X-Plex-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Library Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add items to a collection",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/library/collections/:collectionId/items",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "The collection id"
              },
              {
                "name": "uri",
                "value": "",
                "type": "query",
                "description": "The URI describing the items to add to this collection"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Add items to a collection by uri"
        },
        {
          "info": {
            "name": "Delete an item from a collection",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/library/collections/:collectionId/items/:itemId",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "The collection id"
              },
              {
                "name": "itemId",
                "value": "",
                "type": "path",
                "description": "The item to delete"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Delete an item from a collection"
        },
        {
          "info": {
            "name": "Reorder an item in the collection",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{IP-description}.{identifier}.plex.direct:{port}/library/collections/:collectionId/items/:itemId/move",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "The collection id"
              },
              {
                "name": "itemId",
                "value": "",
                "type": "path",
                "description": "The item to move"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "The item to move this item after.  If not provided, this item will be moved to the beginning"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Plex-Token",
              "value": "{{X-Plex-Token}}",
              "placement": "header"
            }
          },
          "docs": "Reorder items in a collection with one item after another"
        }
      ]
    }
  ],
  "bundled": true
}